RewriteRule ^images/vind_och_gards_samt_kallarupphamtning_v1\.webp$ https://avfallskonsulten.se/bilder/vind_och_gards_samt_kallarupphamtning_v1-1200.webp [R=301,L]
RewriteRule ^images/vind_och_gards_samt_kallarupphamtning_v2\.jpg$ https://avfallskonsulten.se/bilder/vind_och_gards_samt_kallarupphamtning_v1-1200.webp [R=301,L]
