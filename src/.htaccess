# avfallskonsulten.se på Loopia (Apache 2.4). Kopieras till docs/.htaccess av build.py.
# GitHub Pages (staging) ignorerar den här filen, den gäller bara på webbhotellet.

Options -Indexes -MultiViews
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. http -> https (fungerar även om webbhotellet terminerar TLS i en proxy)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://avfallskonsulten.se%{REQUEST_URI} [R=301,L]

# 2. www -> utan www (i samma steg som https ovan, så http://www blir ett enda hopp)
RewriteCond %{HTTP_HOST} ^www\.avfallskonsulten\.se$ [NC]
RewriteRule ^ https://avfallskonsulten.se%{REQUEST_URI} [R=301,L]

# 3. Gamla dubblettadresser -> en adress per sida
# Målen skrivs med https://avfallskonsulten.se. Loopia avslutar TLS före Apache, så ett mål som bara är en sökväg
# blir http://... och ger ett extra hopp via regel 1 (syns på gamla sajten i dag).
RewriteRule ^atervinning/?$ https://avfallskonsulten.se/atervinning-stockholm [R=301,L]
RewriteRule ^atervinning_brf/?$ https://avfallskonsulten.se/atervinning_fastighet_och_brf [R=301,L]
# Felstavad adress som gamla sajten länkade till internt
RewriteRule ^atervinnings_for_foretag_och_verksamheter/?$ https://avfallskonsulten.se/atervinning_for_foretag_och_verksamheter [R=301,L]
# Adresser från WordPress-sajten (2018 till 2022). De fyra första 301:as redan i dag på gamla sajten och ska fortsätta göra det,
# de övriga skickas i dag till startsidan med 302 och får nu närmaste motsvarande sida (se innehall/gamla-urler.csv)
RewriteRule ^fastighet-brf/?$ https://avfallskonsulten.se/atervinning_fastighet_och_brf [R=301,L]
RewriteRule ^grovavfall/?$ https://avfallskonsulten.se/hamta-grovsopor-stockholm [R=301,L]
RewriteRule ^rengoring-sopkarl-soprum/?$ https://avfallskonsulten.se/karltvatt [R=301,L]
RewriteRule ^soprumsrenovering/?$ https://avfallskonsulten.se/radgivning [R=301,L]
RewriteRule ^hamtning-av-matavfall/?$ https://avfallskonsulten.se/matavfall-i-stockholm [R=301,L]
RewriteRule ^hamtning-av-restavfall/?$ https://avfallskonsulten.se/hamtning-av-restavfall-stockholm [R=301,L]
RewriteRule ^hamtning-av-tidningar/?$ https://avfallskonsulten.se/tidningsatervinning [R=301,L]
RewriteRule ^sopkarl-utrustning/?$ https://avfallskonsulten.se/produkter [R=301,L]
RewriteRule ^atervinning-for-privatperson/?$ https://avfallskonsulten.se/ [R=301,L]
# Webbläsare och gamla länkar frågar efter favicon.ico, nya sajten har favicon.png
RewriteRule ^favicon\.ico$ https://avfallskonsulten.se/favicon.png [R=301,L]
# Kommunsidor för grovsopor borttagna 2026-10-19 (bara Stockholm och Lidingö kvar)
RewriteRule ^hamta-grovsopor-(sundbyberg|jarfalla|taby|sollentuna|norrtalje)/?$ https://avfallskonsulten.se/hamta-grovsopor-stockholm [R=301,L]

# BILDER START (skapas av tools/matcha_gamla_bilder.py, ändra inte för hand)
# Gamla bildadresser från förra sajten -> samma bild på nya sajten. Övriga under /images/ ger 410 (borttagen).
