    <script>

  /* (2/3) faktorn beror på formatet på bilden*/
  function changeImg(){
    const front = document.getElementsByClassName('front')[0];
    const frontInitialHeight = front.clientHeight
    const front_image = front.getElementsByTagName('img')[0];
    const aspect = front_image.width / front_image.height

    let width = screen.width;
    let aspectElement = width / frontInitialHeight
    if(aspect >= aspectElement){
      front_image.style.width = "auto";
      front_image.style.height = "100%";
    }
    else{
      front_image.style.width = "100%";
      front_image.style.height = "auto";
    }
  }
  window.addEventListener('resize', changeImg);
  window.addEventListener('load', changeImg);
</script>
